# Postgres connection (Neon, Supabase, Vercel Postgres, local, ...)
DATABASE_URL=postgresql://postgres@localhost:5432/wedo
# Only needed for `prisma migrate dev`
SHADOW_DATABASE_URL=

# Auth0 (Regular Web Application). Allowed callback URL: <APP_BASE_URL>/auth/callback
# Allowed logout URL: <APP_BASE_URL>
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret: openssl rand -hex 32
AUTH0_SECRET=
# Optional on Vercel previews (inferred from the request host)
APP_BASE_URL=http://localhost:3000

# Comma-separated, verified Auth0 emails allowed into /god and /checkin. Empty = nobody.
ADMIN_EMAILS=

# hCaptcha. These are hCaptcha's public test keys, which always pass; replace in production.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Optional: Slack RSVP notifications (channel is set in /god/settings)
SLACK_BOT_TOKEN=

# Optional: Google Maps embed on the FAQ
GOOGLE_MAPS_API_KEY=

# Optional: image uploads in /god/settings. Connecting a Vercel Blob store to the project sets
# BLOB_STORE_ID (auth via Vercel OIDC); outside Vercel, use a read-write token instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
